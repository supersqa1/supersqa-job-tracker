# SQLite database file path.
# Local development can use a relative path. Production should use persistent storage.
DATABASE_PATH=data/job_tracker.db

# Comma-separated frontend origins allowed for CORS.
# Production example: CORS_ORIGINS=https://your-production-domain.example
CORS_ORIGINS=http://localhost:8050

# API host/port.
HOST=0.0.0.0
PORT=3050

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not deploy with placeholder or demo credentials. See docs/PRODUCTION_READINESS.md.
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME=replace-with-private-admin-username
DEFAULT_ADMIN_PASSWORD=replace-with-strong-private-password
